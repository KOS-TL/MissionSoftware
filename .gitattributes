# Default: let git normalise text files.
* text=auto

# Files executed inside the Linux container MUST stay LF even on Windows checkouts,
# otherwise bash fails with "$'\r': command not found".
*.sh       text eol=lf
*.py       text eol=lf
*.c        text eol=lf
*.h        text eol=lf
*.system   text eol=lf
Makefile   text eol=lf
*.json     text eol=lf
*.md       text eol=lf
*.yml      text eol=lf
*.cff      text eol=lf
*.log      text eol=lf
# csv files are written by Python's csv module with CRLF row endings; keep them byte-for-byte.
*.csv      -text
SHA256SUMS text eol=lf

# cmd.exe batch files need CRLF.
*.bat      text eol=crlf

# Binary assets
*.png  binary
*.pdf  binary
*.docx binary
*.pptx binary
